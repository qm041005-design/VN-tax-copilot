# Copy file này thành `.env` khi chạy local:  copy .env.example .env   (KHÔNG commit file .env)
# Chuỗi kết nối Postgres – khớp với service `db` trong docker-compose.yml (cổng 5432 đã map ra máy)
DATABASE_URL=postgresql://vntax_admin:vntax_secret@localhost:5432/vntax_copilot
# dev | staging | prod
APP_ENV=dev

# --- CORS ---
# Các origin frontend được gọi backend từ trình duyệt, ngăn cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Xác thực tối thiểu (môi trường thử nghiệm) ---
# token:user_id:tenant_id, ngăn cách bằng dấu phẩy; token >= 16 ký tự. Rỗng = mọi request bị 401.
# Token dưới đây CHỈ dùng local; staging tạo token ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(24))"
AUTH_TOKENS=dev-token-alice-0001:alice:thtax,dev-token-bob-0002:bob:other
