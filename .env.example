# Cấu hình mẫu để chạy trên máy cá nhân
POSTGRES_USER=vntax_admin
POSTGRES_PASSWORD=vntax_secret
POSTGRES_DB=vntax_copilot

APP_ENV=dev
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local demonstration only. NEXT_PUBLIC_* is visible to every browser user.
AUTH_TOKENS=dev-token-alice-0001:alice:thtax,dev-token-bob-0002:bob:other
NEXT_PUBLIC_DEV_API_TOKEN=dev-token-alice-0001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Keep these values aligned when changing ports:
# BACKEND_PORT -> NEXT_PUBLIC_API_BASE_URL
# FRONTEND_PORT -> CORS_ORIGINS (include http://localhost:<port>)
# NEXT_PUBLIC_* are build-time values; rebuild frontend after changing them.
# For this local Compose URL, use URL-safe POSTGRES_USER/PASSWORD values.
# Changing POSTGRES_* does not rename/reset a database in an existing volume.
# Never set TEST_DATABASE_URL to this demo database; use compose.test.yml.
